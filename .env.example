# 智能投顾AI助手系统 - 环境变量配置
# 复制此文件为 .env 并填入实际值

# ========== LLM配置 ==========
DASHSCOPE_API_KEY=your-dashscope-api-key-here

# ========== 服务配置 ==========
APP_HOST=0.0.0.0
APP_PORT=8002
APP_NAME=智能投顾AI助手系统
DEBUG=false

# ========== API认证（逗号分隔，为空则不启用认证） ==========
API_KEYS=

# ========== CORS配置（逗号分隔的允许域名） ==========
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# ========== 速率限制 ==========
RATE_LIMIT_PER_MINUTE=30

# ========== 请求超时（秒）- 投研分析5阶段LLM调用需较长时间 ==========
REQUEST_TIMEOUT=300

# ========== 日志配置 ==========
LOG_FILE=logs/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
